# Backend Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/claimwise
JWT_SECRET=claimwise_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://127.0.0.1:8001
FRONTEND_URL=http://localhost:5173
MAX_FILE_SIZE_MB=5

# ML Service Configuration
ML_PORT=8001
# Optional LLM Configuration (LangChain Assistant works with deterministic fallback if omitted)
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=15

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api

